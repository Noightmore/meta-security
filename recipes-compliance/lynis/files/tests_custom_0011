#!/bin/sh

#################################################################################
#
# OE custom test: pam-password-quality-policy
# Test : CUST-0011
# Description : Validate PAM and libpwquality password policy
#

TEST_NO="CUST-0011"

Register --test-no "${TEST_NO}" \
    --weight L \
    --network NO \
    --category security \
    --description "Checking PAM password quality policy"

if [ "${SKIPTEST}" = "0" ]; then
    PAM_PASSWORD_FILE="${ROOTDIR}etc/pam.d/common-password"
    PWQUALITY_FILE="${ROOTDIR}etc/security/pwquality.conf"

    PAM_MODULE_PRESENT=0
    PAM_STACK_VALID=0
    PWQUALITY_VALUES_VALID=1
    PWQUALITY_ROOT_VALID=0
    POLICY_VALID=0

    LogText "Test: validating PAM and libpwquality password policy"

    ###########################################################################
    # Check that pam_pwquality.so is installed
    ###########################################################################

    for PAM_MODULE_FILE in \
        "${ROOTDIR}usr/lib/security/pam_pwquality.so" \
        "${ROOTDIR}lib/security/pam_pwquality.so" \
        "${ROOTDIR}usr/lib64/security/pam_pwquality.so" \
        "${ROOTDIR}lib64/security/pam_pwquality.so"
    do
        if [ -r "${PAM_MODULE_FILE}" ]; then
            PAM_MODULE_PRESENT=1
            LogText "Result: PAM module found at ${PAM_MODULE_FILE}"
            break
        fi
    done

    if [ "${PAM_MODULE_PRESENT}" != "1" ]; then
        LogText "Result: pam_pwquality.so was not found"
    fi

    ###########################################################################
    # Check the exact active PAM password stack and its ordering
    ###########################################################################

    if [ -r "${PAM_PASSWORD_FILE}" ]; then
        PAM_STACK_VALID=$(${AWKBINARY} '
            /^[[:space:]]*#/ {
                next
            }

            $1 == "password" && $2 == "requisite" &&
            $3 == "pam_pwquality.so" && $4 == "retry=3" &&
            NF == 4 {
                pwquality_line = NR
            }

            $1 == "password" && $2 == "[success=1" &&
            $3 == "default=ignore]" && $4 == "pam_unix.so" &&
            $5 == "use_authtok" && $6 == "sha512" &&
            NF == 6 {
                unix_line = NR
            }

            $1 == "password" && $2 == "requisite" &&
            $3 == "pam_deny.so" && NF == 3 {
                deny_line = NR
            }

            $1 == "password" && $2 == "required" &&
            $3 == "pam_permit.so" && NF == 3 {
                permit_line = NR
            }

            END {
                if (pwquality_line > 0 && unix_line > pwquality_line && deny_line > unix_line && permit_line > deny_line) {
                    print 1
                } else {
                    print 0
                }
            }
        ' "${PAM_PASSWORD_FILE}")

        # Ensure that a failed AWK invocation cannot leave an invalid value.
        case "${PAM_STACK_VALID}" in
            1)
                ;;
            *)
                PAM_STACK_VALID=0
                ;;
        esac
    else
        PAM_STACK_VALID=0
        LogText "Result: ${PAM_PASSWORD_FILE} does not exist or is not readable"
    fi

    ###########################################################################
    # Check exact pwquality.conf values
    ###########################################################################

    if [ -r "${PWQUALITY_FILE}" ]; then
        for PWQ_REQUIREMENT in \
            "minlen=12" \
            "dcredit=0" \
            "ucredit=0" \
            "lcredit=0" \
            "ocredit=0" \
            "difok=4" \
            "maxrepeat=3" \
            "maxsequence=3" \
            "dictcheck=1" \
            "usercheck=1" \
            "usersubstr=4" \
            "enforcing=1"
        do
            PWQ_KEY="${PWQ_REQUIREMENT%%=*}"
            PWQ_EXPECTED="${PWQ_REQUIREMENT#*=}"

            PWQ_ACTUAL=$(${AWKBINARY} \
                -v wanted="${PWQ_KEY}" '
                {
                    line = $0

                    # Remove comments.
                    sub(/[[:space:]]*#.*/, "", line)

                    separator = index(line, "=")

                    if (separator > 0) {
                        key = substr(line, 1, separator - 1)
                        value = substr(line, separator + 1)

                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
                        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)

                        if (key == wanted) {
                            result = value
                            found = 1
                        }
                    }
                }

                END {
                    if (found) {
                        print result
                    }
                }
            ' "${PWQUALITY_FILE}")

            if [ "${PWQ_ACTUAL}" != "${PWQ_EXPECTED}" ]; then
                PWQUALITY_VALUES_VALID=0

                LogText "Result: ${PWQ_KEY} expected ${PWQ_EXPECTED}, found ${PWQ_ACTUAL:-not configured}"
            else
                LogText "Result: ${PWQ_KEY} is configured as ${PWQ_ACTUAL}"
            fi
        done

        PWQUALITY_ROOT_VALID=$(${AWKBINARY} '
            {
                line = $0

                # Remove comments.
                sub(/[[:space:]]*#.*/, "", line)

                if (line ~ /^[[:space:]]*enforce_for_root([[:space:]]*=[[:space:]]*(1|yes|true))?[[:space:]]*$/) {
                    enabled = 1
                }
            }

            END {
                if (enabled) {
                    print 1
                } else {
                    print 0
                }
            }
        ' "${PWQUALITY_FILE}")

        case "${PWQUALITY_ROOT_VALID}" in
            1)
                LogText "Result: enforce_for_root is enabled"
                ;;
            *)
                PWQUALITY_ROOT_VALID=0
                LogText "Result: enforce_for_root is not enabled"
                ;;
        esac
    else
        PWQUALITY_VALUES_VALID=0
        PWQUALITY_ROOT_VALID=0
        LogText "Result: ${PWQUALITY_FILE} does not exist or is not readable"
    fi

    ###########################################################################
    # Display individual component results
    ###########################################################################

    if [ "${PAM_MODULE_PRESENT}" = "1" ]; then
        Display --indent 2 \
            --text "- pam_pwquality module" \
            --result "installed" \
            --color GREEN
    else
        Display --indent 2 \
            --text "- pam_pwquality module" \
            --result "not found" \
            --color YELLOW
    fi

    if [ "${PAM_STACK_VALID}" = "1" ]; then
        Display --indent 2 \
            --text "- PAM password stack" \
            --result "configured" \
            --color GREEN
    else
        Display --indent 2 \
            --text "- PAM password stack" \
            --result "incorrect" \
            --color YELLOW
    fi

    if [ "${PWQUALITY_VALUES_VALID}" = "1" ] &&
       [ "${PWQUALITY_ROOT_VALID}" = "1" ]; then
        Display --indent 2 \
            --text "- Password quality settings" \
            --result "configured" \
            --color GREEN
    else
        Display --indent 2 \
            --text "- Password quality settings" \
            --result "incorrect" \
            --color YELLOW
    fi

    ###########################################################################
    # Overall result
    ###########################################################################

    if [ "${PAM_MODULE_PRESENT}" = "1" ] &&
       [ "${PAM_STACK_VALID}" = "1" ] &&
       [ "${PWQUALITY_VALUES_VALID}" = "1" ] &&
       [ "${PWQUALITY_ROOT_VALID}" = "1" ]; then
        POLICY_VALID=1
    fi

    if [ "${POLICY_VALID}" = "1" ]; then
        LogText "Result: PAM password quality policy is correctly configured"

        Report "password_quality_policy=enabled"
        Report "password_minimum_length=12"

        AddHP 4 4
    else
        LogText "Result: PAM password quality policy is incomplete or incorrect"

        Report "password_quality_policy=invalid"

        ReportSuggestion "${TEST_NO}" \
            "Configure pam_pwquality and /etc/security/pwquality.conf according to the system password policy"

        AddHP 0 4
    fi

    unset PAM_PASSWORD_FILE
    unset PWQUALITY_FILE
    unset PAM_MODULE_FILE
    unset PAM_MODULE_PRESENT
    unset PAM_STACK_VALID
    unset PWQUALITY_VALUES_VALID
    unset PWQUALITY_ROOT_VALID
    unset POLICY_VALID
    unset PWQ_REQUIREMENT
    unset PWQ_KEY
    unset PWQ_EXPECTED
    unset PWQ_ACTUAL
fi