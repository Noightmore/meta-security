#!/bin/sh

################################################################################
#
# OE custom test: failed-authentication lockout policy
# Test: CUST-0012
#
# Checks:
#   1. pam_faillock.so is installed.
#   2. pam_faillock is correctly integrated into common-auth.
#   3. faillock.conf matches the policy defined below.
#
################################################################################

CUST0012_TEST_NO="CUST-0012"

################################################################################
# Expected policy
################################################################################

CUST0012_EXPECTED_DENY="30"
CUST0012_EXPECTED_FAIL_INTERVAL="900"
CUST0012_EXPECTED_UNLOCK_TIME="900"
CUST0012_EXPECTED_SILENT="1"
CUST0012_EXPECTED_EVEN_DENY_ROOT="0"


CUST0012_CheckModule()
{
    for CUST0012_MODULE in \
        "${ROOTDIR}usr/lib/security/pam_faillock.so" \
        "${ROOTDIR}lib/security/pam_faillock.so" \
        "${ROOTDIR}usr/lib64/security/pam_faillock.so" \
        "${ROOTDIR}lib64/security/pam_faillock.so"
    do
        if [ -r "${CUST0012_MODULE}" ]; then
            LogText "Result: PAM module found at ${CUST0012_MODULE}"
            return 0
        fi
    done

    LogText "Result: pam_faillock.so was not found"
    return 1
}


CUST0012_CheckPamStack()
{
    CUST0012_FILE="$1"

    if [ ! -r "${CUST0012_FILE}" ]; then
        LogText "Result: ${CUST0012_FILE} is not readable"
        return 1
    fi

    CUST0012_PAM_SUMMARY=$(${AWKBINARY} '
        /^[[:space:]]*#/ {
            next
        }

        $1 == "auth" && $2 == "required" &&
        $3 == "pam_faillock.so" && $4 == "preauth" &&
        NF == 4 {
            preauth_line = NR
            preauth_count++
        }

        $1 == "auth" && $2 == "[success=1" &&
        $3 == "default=bad]" && $4 == "pam_unix.so" &&
        NF == 4 {
            unix_line = NR
            unix_count++
        }

        $1 == "auth" && $2 == "[default=die]" &&
        $3 == "pam_faillock.so" && $4 == "authfail" &&
        NF == 4 {
            authfail_line = NR
            authfail_count++
        }

        $1 == "auth" && $2 == "sufficient" &&
        $3 == "pam_faillock.so" && $4 == "authsucc" &&
        NF == 4 {
            authsucc_line = NR
            authsucc_count++
        }

        $1 == "auth" && $2 == "required" &&
        $3 == "pam_deny.so" && NF == 3 {
            deny_line = NR
            deny_count++
        }

        END {
            printf "preauth=%d, pam_unix=%d, authfail=%d, authsucc=%d, deny=%d",
                preauth_count,
                unix_count,
                authfail_count,
                authsucc_count,
                deny_count

            valid = preauth_count == 1 &&
                    unix_count == 1 &&
                    authfail_count == 1 &&
                    authsucc_count == 1 &&
                    deny_count == 1 &&
                    preauth_line < unix_line &&
                    unix_line < authfail_line &&
                    authfail_line < authsucc_line &&
                    authsucc_line < deny_line

            if (valid) {
                exit 0
            }

            exit 1
        }
    ' "${CUST0012_FILE}")

    CUST0012_STATUS="$?"
    LogText "Result: PAM stack: ${CUST0012_PAM_SUMMARY}"

    return "${CUST0012_STATUS}"
}


CUST0012_CheckConfig()
{
    CUST0012_FILE="$1"

    if [ ! -r "${CUST0012_FILE}" ]; then
        LogText "Result: ${CUST0012_FILE} is not readable"
        return 1
    fi

    CUST0012_CONFIG_SUMMARY=$(
        ${AWKBINARY} \
            -v expected_deny="${CUST0012_EXPECTED_DENY}" \
            -v expected_fail_interval="${CUST0012_EXPECTED_FAIL_INTERVAL}" \
            -v expected_unlock_time="${CUST0012_EXPECTED_UNLOCK_TIME}" \
            -v expected_silent="${CUST0012_EXPECTED_SILENT}" \
            -v expected_deny_root="${CUST0012_EXPECTED_EVEN_DENY_ROOT}" '
        function trim(value) {
            sub(/^[[:space:]]+/, "", value)
            sub(/[[:space:]]+$/, "", value)
            return value
        }

        {
            line = $0

            sub(/[[:space:]]*#.*/, "", line)
            line = trim(line)

            if (line == "") {
                next
            }

            if (line == "silent") {
                silent = 1
                next
            }

            if (line == "even_deny_root") {
                deny_root = 1
                next
            }

            separator = index(line, "=")

            if (separator == 0) {
                next
            }

            key = trim(substr(line, 1, separator - 1))
            value = trim(substr(line, separator + 1))

            if (key == "deny") {
                deny = value
            } else if (key == "fail_interval") {
                fail_interval = value
            } else if (key == "unlock_time") {
                unlock_time = value
            }
        }

        END {
            printf "deny=%s, fail_interval=%s, unlock_time=%s, silent=%d, even_deny_root=%d",
                deny,
                fail_interval,
                unlock_time,
                silent,
                deny_root

            valid = deny == expected_deny &&
                    fail_interval == expected_fail_interval &&
                    unlock_time == expected_unlock_time &&
                    silent == expected_silent &&
                    deny_root == expected_deny_root

            if (valid) {
                exit 0
            }

            exit 1
        }
    ' "${CUST0012_FILE}"
    )

    CUST0012_STATUS="$?"

    LogText "Result: faillock configuration: ${CUST0012_CONFIG_SUMMARY}"
    LogText "Expected: deny=${CUST0012_EXPECTED_DENY}, fail_interval=${CUST0012_EXPECTED_FAIL_INTERVAL}, unlock_time=${CUST0012_EXPECTED_UNLOCK_TIME}, silent=${CUST0012_EXPECTED_SILENT}, even_deny_root=${CUST0012_EXPECTED_EVEN_DENY_ROOT}"

    return "${CUST0012_STATUS}"
}


CUST0012_DisplayResult()
{
    if [ "$2" = "1" ]; then
        Display --indent 2 \
            --text "$1" \
            --result "$3" \
            --color GREEN
    else
        Display --indent 2 \
            --text "$1" \
            --result "$4" \
            --color YELLOW
    fi
}


CUST0012_Main()
{
    CUST0012_PAM_FILE="${ROOTDIR}etc/pam.d/common-auth"
    CUST0012_CONFIG_FILE="${ROOTDIR}etc/security/faillock.conf"

    CUST0012_MODULE_VALID=0
    CUST0012_STACK_VALID=0
    CUST0012_CONFIG_VALID=0

    CUST0012_POLICY_RESULT="${CUST0012_EXPECTED_DENY} attempts / ${CUST0012_EXPECTED_FAIL_INTERVAL}s window / ${CUST0012_EXPECTED_UNLOCK_TIME}s unlock"

    LogText "Test: validating failed-authentication lockout policy"

    if CUST0012_CheckModule; then
        CUST0012_MODULE_VALID=1
    fi

    if CUST0012_CheckPamStack "${CUST0012_PAM_FILE}"; then
        CUST0012_STACK_VALID=1
    fi

    if CUST0012_CheckConfig "${CUST0012_CONFIG_FILE}"; then
        CUST0012_CONFIG_VALID=1
    fi

    CUST0012_DisplayResult \
        "- pam_faillock module" \
        "${CUST0012_MODULE_VALID}" \
        "installed" \
        "not found"

    CUST0012_DisplayResult \
        "- PAM authentication stack" \
        "${CUST0012_STACK_VALID}" \
        "configured" \
        "incorrect"

    CUST0012_DisplayResult \
        "- Failed-login policy" \
        "${CUST0012_CONFIG_VALID}" \
        "${CUST0012_POLICY_RESULT}" \
        "incorrect"

    if [ "${CUST0012_MODULE_VALID}" = "1" ] &&
       [ "${CUST0012_STACK_VALID}" = "1" ] &&
       [ "${CUST0012_CONFIG_VALID}" = "1" ]; then
        LogText "Result: failed-authentication lockout policy is enabled"

        Report "authentication_lockout_policy=enabled"
        Report "authentication_lockout_attempts=${CUST0012_EXPECTED_DENY}"
        Report "authentication_lockout_interval=${CUST0012_EXPECTED_FAIL_INTERVAL}"
        Report "authentication_unlock_time=${CUST0012_EXPECTED_UNLOCK_TIME}"
        Report "authentication_lockout_silent=${CUST0012_EXPECTED_SILENT}"
        Report "authentication_lockout_root=${CUST0012_EXPECTED_EVEN_DENY_ROOT}"

        AddHP 4 4
    else
        LogText "Result: failed-authentication lockout policy is incomplete"

        Report "authentication_lockout_policy=invalid"

        ReportSuggestion "${CUST0012_TEST_NO}" \
            "Configure pam_faillock with deny=${CUST0012_EXPECTED_DENY}, fail_interval=${CUST0012_EXPECTED_FAIL_INTERVAL}, and unlock_time=${CUST0012_EXPECTED_UNLOCK_TIME}"

        AddHP 0 4
    fi
}


Register --test-no "${CUST0012_TEST_NO}" \
    --weight L \
    --network NO \
    --category security \
    --description "Checking failed-authentication lockout policy"

if [ "${SKIPTEST}" = "0" ]; then
    CUST0012_Main
fi